.btn-blue {
    align-items: stretch;
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    padding-top: 12px;
    padding-right: 30px;
    padding-bottom: 12px;
    padding-left: 30px;
    border-top-left-radius: 24px;
    border-top-right-radius: 24px;
    border-bottom-right-radius: 24px;
    border-bottom-left-radius: 24px;
    flex-basis: 200px;
    background-color: rgb(20, 102, 231);
    transition-duration: 0.3s;
}

.btn-blue:hover {
    background-color: rgb(104, 163, 237);
}

.pop-up-content {
    flex-grow: 1;
    background-size: 800px 600px;
    width: 800px;
    height: 600px;
}

.pop-up-window {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(74, 74, 74, 0.68);
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
}

.pop-up-window.open {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(74, 74, 74, 0.68);
    justify-content: center;
    align-items: center;
    opacity: 1;
    visibility: visible;
}
